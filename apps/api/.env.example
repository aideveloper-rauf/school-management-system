# Copy to .env (never commit .env). All values below are placeholders.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Public origin of the web app (used for CORS-free same-origin checks and cookies).
APP_ORIGIN=http://localhost:5173

# Per-installation MySQL credentials — unique to this school.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_sms
DB_USER=school_sms
DB_PASSWORD=change-me

# Session lifetime in minutes (idle sessions expire after this).
SESSION_TTL_MINUTES=480

# Private file storage OUTSIDE the public web root.
STORAGE_DIR=../../storage

# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info

# Set to true only behind HTTPS (production must be true).
COOKIE_SECURE=false

# Optional features — disabled by default.
FEATURE_AI=false

# Outgoing email for invitations and password resets.
# file = write messages to STORAGE_DIR/outbox (development only); smtp = send via the SMTP server below.
MAIL_TRANSPORT=file
MAIL_FROM=School <no-reply@school.example.lk>
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false uses STARTTLS when the server offers it.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

{
  "name": "@sms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "setup:admin": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "jobs:run": "tsx --env-file-if-exists=.env src/cli/run-jobs.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@sms/shared": "0.1.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.0",
    "kysely": "^0.29.0",
    "mysql2": "^3.15.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
